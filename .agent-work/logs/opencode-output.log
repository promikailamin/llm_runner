from pathlib import Path
p = Path('.github/workflows/models-release.yml')
s = p.read_text()
start = s.index('      - name: Pull models\n')
end = s.index('      - name: Add summary\n')
new_block = '''      - name: Prepare release
        env:
          DRAFT: ${{ inputs.draft }}
        run: |
          set -euo pipefail
          if gh api "repos/${REPOSITORY}/releases/tags/${RELEASE_TAG}" >/dev/null 2>&1; then
            echo "Release ${RELEASE_TAG} already exists"
            exit 0
          fi
          args=(--repo "$REPOSITORY" --title "LLM models")
          if [ "$DRAFT" = "true" ]; then
            args+=(--draft)
          fi
          gh release create "$RELEASE_TAG" "${args[@]}" \\
            --notes "Model assets are generated by the Publish LLM models workflow."

      - name: Pull, package and upload models
        env:
          VERIFY_BLOBS: ${{ inputs.verify_blobs }}
        run: |
          set -euo pipefail
          stage="$RUNNER_TEMP/llm-model-assets"
          rm -rf "$stage"
          mkdir -p "$stage"
          : > "$stage/SHA256SUMS"
          echo "ASSET_DIR=$stage" >> "$GITHUB_ENV"

          verify_flag=()
          if [ "$VERIFY_BLOBS" = "true" ]; then
            verify_flag+=(--verify)
          fi

          while IFS= read -r model; do
            [ -z "$model" ] && continue
            bash scripts/pull-model.sh "$model"

            python3 scripts/package-ollama-model.py \\
              --model "$model" \\
              --models-dir "$OLLAMA_MODELS" \\
              --output-dir "$stage" \\
              --chunk-size "$CHUNK_SIZE" \\
              --catalog "$stage/models-manifest.json" \\
              --checksums "$stage/SHA256SUMS" \\
              "${verify_flag[@]}"

            safe_name="$(jq -r --arg model "$model" \\
              '.models[] | select(.model == $model) | .safe_name' \\
              "$stage/models-manifest.json")"
            mapfile -t model_assets < <(find "$stage" -maxdepth 1 -type f \\
              -name "${safe_name}.tar.part-*" | LC_ALL=C sort)
            if [ "${#model_assets[@]}" -eq 0 ]; then
              echo "No parts produced for ${model}" >&2
              exit 1
            fi
            printf 'Uploading %d part(s) for %s\\n' "${#model_assets[@]}" "$model"
            gh release upload "$RELEASE_TAG" "${model_assets[@]}" \\
              --repo "$REPOSITORY" --clobber
            rm -f "${model_assets[@]}"

            OLLAMA_HOST="${OLLAMA_HOST:-http://127.0.0.1:11434}" ollama stop "$model" >/dev/null 2>&1 || true
            OLLAMA_HOST="${OLLAMA_HOST:-http://127.0.0.1:11434}" ollama rm "$model" >/dev/null 2>&1 || true
          done < "$MODELS_FILE"

          if [ ! -s "$stage/SHA256SUMS" ]; then
            echo "No model assets were produced" >&2
            exit 1
          fi

      - name: Write release notes
        run: |
          # shellcheck disable=SC2016
          set -euo pipefail
          notes="$RUNNER_TEMP/release-notes.md"
          {
            echo "# LLM model assets"
            echo
            echo "Ollama models packaged for the LLM tunnel workflow."
            echo
            echo "## Models"
            echo
            # shellcheck disable=SC2016
            jq -r '.models[] | "- `\\(.model)` - \\(.parts | length) part(s), \\(.total_size) bytes"' \\
              "$ASSET_DIR/models-manifest.json"
            echo
            echo "## Assets"
            echo
            echo "Assets are split into parts under 2000 MB because GitHub's"
            echo "release asset limit is 2 GiB per file. Download every"
            # shellcheck disable=SC2016
            echo '`<model>.tar.part-*` file for the model you need and join them:'
            echo
            # shellcheck disable=SC2016
            echo '```bash'
            echo 'cat <model>.tar.part-* | tar -xf - -C ~/.ollama/models'
            # shellcheck disable=SC2016
            echo '```'
            echo
            # shellcheck disable=SC2016
            echo '`SHA256SUMS` contains the checksum of every part.'
            echo
            echo "Then use the **LLM over bore.pub** workflow with"
            # shellcheck disable=SC2016
            echo '`model_source=release` and this release tag.'
          } > "$notes"
          echo "RELEASE_NOTES=$notes" >> "$GITHUB_ENV"
          cat "$notes"

      - name: Update release notes
        run: |
          set -euo pipefail
          gh release edit "$RELEASE_TAG" --repo "$REPOSITORY" \\
            --title "LLM models" --notes-file "$RELEASE_NOTES"

      - name: Upload catalog and checksums
        run: |
          set -euo pipefail
          mapfile -t assets < <(find "$ASSET_DIR" -maxdepth 1 -type f \\
            \\( -name 'SHA256SUMS' -o -name 'models-manifest.json' \\) | LC_ALL=C sort)
          if [ "${#assets[@]}" -eq 0 ]; then
            echo "No catalog assets found in $ASSET_DIR" >&2
            exit 1
          fi
          gh release upload "$RELEASE_TAG" "${assets[@]}" --repo "$REPOSITORY" --clobber

'''
s = s[:start] + new_block + s[end:]
p.write_text(s)
